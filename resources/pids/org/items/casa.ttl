PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/org/casa>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/org/casa($|/.*)$ "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/casa$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/org/casa(.*).ttl$ "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/casa$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/org/casa($|/.*)$ "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/casa$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/org/casa" ;
            pid:headers "" ;
            pid:to "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/casa" ;
            schema:name "/org/casa HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2022-03-14"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Civil Aviation Safety Authority" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
