PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/org/ada>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/org/ada($|/.*)$ "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/ada$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/org/ada(.*).ttl$ "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/ada$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/org/ada($|/.*)$ "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/ada$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/org/ada" ;
            pid:headers "" ;
            pid:to "https://pidreg.dev.kurrawong.ai/object?iri=https://linked.data.gov.au/org/ada" ;
            schema:name "/org/ada HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2025-01-28"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Australian Data Archive" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/org/ada"^^pid:agldwgPid ;
.
