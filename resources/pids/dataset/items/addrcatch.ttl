PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/dataset/addrcatch>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/dataset/addrcatch				  https://raw.githack.com/CSIRO-enviro-informatics/addrcatch-linkset/master/header.ttl [L,R=302]
RewriteRule ^/dataset/addrcatch				  https://github.com/CSIRO-enviro-informatics/addrcatch-linkset [L,R=302]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/addrcatch" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/CSIRO-enviro-informatics/addrcatch-linkset/master/header.ttl" ;
            schema:name "addrcatch RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/addrcatch" ;
            pid:headers "" ;
            pid:to "https://github.com/CSIRO-enviro-informatics/addrcatch-linkset" ;
            schema:name "addrcatch HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/paul.j.box> ;
    schema:dateCreated "2021-04-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "GNAF Current Addresses to Geofabric Contracted Catchments Linkset" ;
    schema:sponsor <https://linked.data.gov.au/org/csiro> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/dataset/addrcatch"^^pid:agldwgPid ;
.
