PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/dataset/wave>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_format=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^\\/dataset\\/wave(.*)$                    https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=text/turtle [R=302,L]
RewriteRule ^\\/dataset\\/wave(.*).ttl$                https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=text/turtle [R=302,L]
RewriteCond %{QUERY_STRING} ^_format=application/rdf\\+xml$ [OR]
RewriteCond %{HTTP:Accept} application/rdf\\+xml [NC]
RewriteRule ^\\/dataset\\/wave(.*)$                    https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=application/rdf+xml [R=302,L]
RewriteRule ^\\/dataset\\/wave(.*).rdf$                https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=application/rdf+xml [R=302,L]
RewriteCond %{QUERY_STRING} ^_format=application/n-triples$ [OR]
RewriteCond %{HTTP:Accept} application/n-triples [NC]
RewriteRule ^\\/dataset\\/wave(.*)$                    https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=application/n-triples [R=302,L]
RewriteRule ^\\/dataset\\/wave(.*).nt$                 https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=application/n-triples [R=302,L]
RewriteCond %{QUERY_STRING} ^_format=application/ld\\+json$ [OR]
RewriteCond %{HTTP:Accept} application/ld\\+json [NC]
RewriteRule ^\\/dataset\\/wave(.*)$                    https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=application/ld+json [R=302,L]
RewriteRule ^\\/dataset\\/wave(.*).jsonld$             https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=application/ld+json [R=302,L]
RewriteCond %{QUERY_STRING} ^_format=text/n3$ [OR]
RewriteCond %{HTTP:Accept} text/n3 [NC]
RewriteRule ^\\/dataset\\/wave(.*)$                    https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=text/n3 [R=302,L]
RewriteRule ^\\/dataset\\/wave(.*).n3$                 https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=text/n3 [R=302,L]
RewriteRule ^/dataset/wave(.*)$                      https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave$1&sparql_endpoint=https://virtuoso.tern.org.au/sparql [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/wave" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave&sparql_endpoint=https://virtuoso.tern.org.au/sparql&format=text/turtle" ;
            schema:name "Wave Dataset Metadata - one vocab TURTLE" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/wave" ;
            pid:headers "" ;
            pid:to "https://linkeddata.tern.org.au/viewers/general?uri=http://linked.data.gov.au/dataset/wave&sparql_endpoint=https://virtuoso.tern.org.au/sparql" ;
            schema:name "Wave Dataset Metadata - one vocab HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "Wave Dataset" ;
    schema:sponsor <https://linked.data.gov.au/org/tern> ;
    schema:url "https://linked.data.gov.au/dataset/wave"^^pid:agldwgPid ;
.
