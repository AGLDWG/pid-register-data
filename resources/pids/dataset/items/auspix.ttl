PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/dataset/auspix>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/dataset/auspix$ "https://fsdf.org.au/dataset/auspix/index.ttl" [R=302,L]
RewriteRule ^/dataset/auspix.ttl$ "https://fsdf.org.au/dataset/auspix/index.ttl" [R=302,L]
RewriteRule ^/dataset/auspix$ https://fsdf.org.au/dataset/auspix$1 [R=302,L]
RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/dataset/auspix/(.*) "https://fsdf.org.au/dataset/auspix/collections/auspix/items/$1?_mediatype=text/turtle" [R=302,L]
RewriteRule ^/dataset/auspix/(.*) "https://fsdf.org.au/dataset/auspix/collections/auspix/items/$1" [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/auspix" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://fsdf.org.au/dataset/auspix/index.ttl" ;
            schema:name "auspix RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/auspix" ;
            pid:headers "" ;
            pid:to "https://fsdf.org.au/dataset/auspix" ;
            schema:name "auspix HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/irina.bastrakova> ;
    schema:dateCreated "2021-03-17"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "AusPIX dataset" ;
    schema:sponsor <https://linked.data.gov.au/org/ga> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/dataset/auspix"^^pid:agldwgPid ;
.
