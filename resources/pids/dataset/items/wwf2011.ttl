RewriteRule ^/dataset/wwf2011(.*)$                          https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=text/turtle [R=302,L]
RewriteRule ^/dataset/wwf2011(.*).ttl$                      https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=text/turtle [R=302,L]
RewriteCond %{QUERY_STRING} ^_mediatype=application/rdf\\+xml$ [OR]
RewriteCond %{HTTP:Accept} application/rdf\\+xml [NC]
RewriteRule ^/dataset/wwf2011(.*)$                          https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=application/rdf\\+xml [R=302,L]
RewriteRule ^/dataset/wwf2011(.*).rdf$                      https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=application/rdf\\+xml [R=302,L]
RewriteCond %{QUERY_STRING} ^_mediatype=application/n-triples$ [OR]
RewriteCond %{HTTP:Accept} application/n-triples [NC]
RewriteRule ^/dataset/wwf2011(.*)$                          https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=application/n-triples [R=302,L]
RewriteRule ^/dataset/wwf2011(.*).nt$                       https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=application/n-triples [R=302,L]
RewriteCond %{QUERY_STRING} ^_mediatype=application/ld\\+json$ [OR]
RewriteCond %{HTTP:Accept} application/ld\\+json [NC]
RewriteRule ^/dataset/wwf2011(.*)$                          https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=application/ld\\+json [R=302,L]
RewriteRule ^/dataset/wwf2011(.*).jsonld$                   https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=application/ld\\+json [R=302,L]
RewriteCond %{QUERY_STRING} ^_mediatype=text/n3$ [OR]
RewriteCond %{HTTP:Accept} text/n3 [NC]
RewriteRule ^/dataset/wwf2011(.*)$                          https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=text/n3 [R=302,L]
RewriteRule ^/dataset/wwf2011(.*).n3$                       https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1&format=text/n3 [R=302,L]
RewriteRule ^/dataset/wwf2011$                              https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011 [R=302,L]
RewriteRule ^/dataset/wwf2011(.*)$                          https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/dataset/wwf2011" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://linkeddata.tern.org.au/viewers/administrative-areas?uri=https://linked.data.gov.au/dataset/wwf2011&format=text/turtle" ;
