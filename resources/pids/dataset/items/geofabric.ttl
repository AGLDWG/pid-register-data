RewriteRule ^/dataset/geofabric/hydroid/(.*)$ "https://geofabric.linked.fsdf.org.au/object?uri=https://%{HTTP_HOST}%{REQUEST_URI}" [R=302,L]"""^^pid:apacheRedirectRules ;
