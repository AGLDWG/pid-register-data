PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/reg-statuses>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/reg-statuses$                         https://agldwg.github.io/reg-statuses/vocabulary.ttl? [R=302,L]
RewriteRule ^/def/reg-statuses.ttl$                     https://agldwg.github.io/reg-statuses/vocabulary.ttl? [R=302,L]
RewriteRule ^/def/reg-statuses$                         https://agldwg.github.io/reg-statuses/ [R=302,L]
RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/reg-statuses/(.+)$                    https://agldwg.github.io/reg-statuses/$1.ttl? [R=302,L]
RewriteRule ^/def/reg-statuses/(.+).ttl$                https://agldwg.github.io/reg-statuses/$1.ttl? [R=302,L]
RewriteRule ^/def/reg-statuses/(.+)$                    https://agldwg.github.io/reg-statuses/$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/reg-statuses/accepted" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/reg-statuses/accepted" ;
            schema:name "AGLDWG Registry Statuses HTML - one Concept" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/reg-statuses" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/reg-statuses/" ;
            schema:name "AGLDWG Registry Statuses Vocabulary HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/reg-statuses" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://agldwg.github.io/reg-statuses/vocabulary.ttl" ;
            schema:name "AGLDWG Registry Statuses vocabulary RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2019-04-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Registry Ontology's Status Vocabulary" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/reg-statuses"^^pid:agldwgPid ;
.
