PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/bore>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/bore$                         https://kurrawong.github.io/bore-model/model.ttl [R=302,L]
RewriteRule ^/def/bore.ttl$                     https://kurrawong.github.io/bore-model/model.ttl [R=302,L]
RewriteRule ^/def/bore$                         https://kurrawong.github.io/bore-model/model.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/bore" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://kurrawong.github.io/bore-model/model.ttl" ;
            schema:name "bore RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/bore" ;
            pid:headers "" ;
            pid:to "https://kurrawong.github.io/bore-model/model.html" ;
            schema:name "bore HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/chee.ng> ;
    schema:dateCreated "2024-06-28"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Bores Model" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    schema:url "https://linked.data.gov.au/def/bore"^^pid:agldwgPid ;
.
