PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/gsq-dataset-theme>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/gsq-dataset-theme($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=gsq-dataset-theme&uri=http://linked.data.gov.au/def/gsq-dataset-theme$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/gsq-dataset-theme($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=gsq-dataset-theme&uri=http://linked.data.gov.au/def/gsq-dataset-theme$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gsq-dataset-theme" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=gsq-dataset-theme&uri=http://linked.data.gov.au/def/gsq-dataset-theme&_mediatype=text/turtle" ;
            schema:name "gsq-dataset-theme RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gsq-dataset-theme" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=gsq-dataset-theme&uri=http://linked.data.gov.au/def/gsq-dataset-theme" ;
            schema:name "gsq-dataset-theme HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/david.crosswell> ;
    schema:dateCreated "2019-06-05"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "GSQ Dataset Theme" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/gsq-dataset-theme"^^pid:agldwgPid ;
.
