PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/geofh>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geofh                     https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/geofh.ttl [R=302,L]
RewriteRule ^/def/geofh.ttl$                https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/geofh.ttl [R=302,L]
RewriteRule ^/def/geofh                     https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/geofh/ [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geofh" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/geofh.ttl" ;
            schema:name "geofh HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geofh" ;
            pid:headers "" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/geofh/" ;
            schema:name "geofh RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "GeoFH" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:url "https://linked.data.gov.au/def/geofh"^^pid:agldwgPid ;
.
