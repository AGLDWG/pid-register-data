PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/auspix>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/auspix(.*)$                             https://geoscienceaustralia.github.io/AusPIX-DGGS-ontology/auspix.ttl? [R=302,L]
RewriteRule ^/def/auspix(.*).ttl$                         https://geoscienceaustralia.github.io/AusPIX-DGGS-ontology/auspix.ttl [R=302,L]
RewriteRule ^/def/auspix(.*)$                             https://geoscienceaustralia.github.io/AusPIX-DGGS-ontology/auspix.html$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/auspix" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geoscienceaustralia.github.io/AusPIX-DGGS-ontology/auspix.ttl" ;
            schema:name "auspix RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/auspix" ;
            pid:headers "" ;
            pid:to "https://geoscienceaustralia.github.io/AusPIX-DGGS-ontology/auspix.html" ;
            schema:name "auspix HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/simon.cox> ;
    schema:dateCreated "2020-05-19"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "AusPix DGGS ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/ga> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/auspix"^^pid:agldwgPid ;
.
