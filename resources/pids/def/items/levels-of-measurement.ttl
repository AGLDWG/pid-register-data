PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/levels-of-measurement>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/levels-of-measurement($|/.*)$        https://agldwg.github.io/levels-of-measurement/vocabulary.ttl [R=302,L]
RewriteRule ^/def/levels-of-measurement.ttl$           https://agldwg.github.io/levels-of-measurement/vocabulary.ttl [R=302,L]
RewriteRule ^/def/levels-of-measurement($|/.*)$        https://agldwg.github.io/levels-of-measurement$1 [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/levels-of-measurement" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://agldwg.github.io/levels-of-measurement/vocabulary.ttl" ;
            schema:name "levels-of-measurement RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/levels-of-measurement" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/levels-of-measurement" ;
            schema:name "levels-of-measurement HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2024-05-30"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Levels of Measurement" ;
    schema:sponsor <https://linked.data.gov.au/org/dcceew> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/levels-of-measurement"^^pid:agldwgPid ;
.
