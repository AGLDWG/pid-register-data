PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/ontpub>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^/def/ontpub$                        https://agldwg.github.io/ontpub-profile/profile.ttl [R=302,L]
RewriteRule ^/def/ontpub.ttl$                    https://agldwg.github.io/ontpub-profile/profile.ttl [R=302,L]
RewriteRule ^/def/ontpub/validator               https://agldwg.github.io/ontpub-profile/validators/validator.ttl [R=302,L]
RewriteRule ^/def/ontpub/repo                    https://github.com/AGLDWG/ontpub-profile [R=302,L]
RewriteRule ^/def/ontpub/spec                    https://agldwg.github.io/ontpub-profile/specification.html [R=302,L]
RewriteRule ^/def/ontpub                         https://agldwg.github.io/ontpub-profile/profile.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/ontpub/spec" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/ontpub-profile/specification.html" ;
            schema:name "OntPub Specification HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/ontpub" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://agldwg.github.io/ontpub-profile/profile.ttl" ;
            schema:name "OntPub Profile RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/ontpub" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/ontpub-profile/profile.html" ;
            schema:name "OntPub Profile HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/ontpub/validator" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://agldwg.github.io/ontpub-profile/validators/validator.ttl" ;
            schema:name "OntPub Validator RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/ontpub/repo" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://github.com/AGLDWG/ontpub-profile" ;
            schema:name "OntPub repo" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "OntPub Profile" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:url "https://linked.data.gov.au/def/ontpub"^^pid:agldwgPid ;
.
