PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/dataset-relationships>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/dataset-relationships($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/dataset-relationships$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/dataset-relationships($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/dataset-relationships$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/dataset-relationships" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/dataset-relationships&_mediatype=text/turtle" ;
            schema:name "dataset-relationships RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/dataset-relationships" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/dataset-relationships" ;
            schema:name "dataset-relationships HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/daniel.brough> ;
    schema:dateCreated "2020-12-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Dataset Relationships" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/unstable> ;
    schema:url "https://linked.data.gov.au/def/dataset-relationships"^^pid:agldwgPid ;
.
