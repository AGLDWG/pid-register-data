PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/geoadminfeatures>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geoadminfeatures                      https://raw.githack.com/geological-survey-of-queensland/geoadmin-features-ont/master/geoadminfeatures.ttl? [R=302,L]
RewriteRule ^/def/geoadminfeatures.ttl$                 https://raw.githack.com/geological-survey-of-queensland/geoadmin-features-ont/master/geoadminfeatures.ttll [R=302,L]
RewriteRule ^/def/geoadminfeatures(.*)$                 https://vocabs.gsq.digital/object?vocab_id=geoadminfeatures&uri=http://linked.data.gov.au/def/geoadminfeatures$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geoadminfeatures" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/geological-survey-of-queensland/geoadmin-features-ont/master/geoadminfeatures.ttl" ;
            schema:name "geoadminfeatures RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geoadminfeatures" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=geoadminfeatures&uri=http://linked.data.gov.au/def/geoadminfeatures" ;
            schema:name "geoadminfeatures HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2019-10-08"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Geo Admin Features Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/geoadminfeatures"^^pid:agldwgPid ;
.
