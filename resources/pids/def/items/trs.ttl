PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/trs>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/trs($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=trs&uri=http://linked.data.gov.au/def/trs$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/trs($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=trs&uri=http://linked.data.gov.au/def/trs$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/trs" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=trs&uri=http://linked.data.gov.au/def/trs&_mediatype=text/turtle" ;
            schema:name "trs RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/trs" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=trs&uri=http://linked.data.gov.au/def/trs" ;
            schema:name "trs HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2019-10-17"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Temporal Reference Systems" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/trs"^^pid:agldwgPid ;
.
