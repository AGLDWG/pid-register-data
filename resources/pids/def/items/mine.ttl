PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/mine>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/mine$                         https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/mine.ttl [R=302,L]
RewriteRule ^/def/mine.ttl$                     https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/mine.ttl [R=302,L]
RewriteRule ^/def/mine$                         https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/mine/ [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/mine" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/mine.ttl" ;
            schema:name "mine RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/mine" ;
            pid:headers "" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/mine/" ;
            schema:name "mine HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2024-06-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Mine Model" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/mine"^^pid:agldwgPid ;
.
