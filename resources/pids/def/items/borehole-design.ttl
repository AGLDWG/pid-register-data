PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/borehole-design>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/borehole-design($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=borehole-design&uri=http://linked.data.gov.au/def/borehole-design$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/borehole-design($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=borehole-design&uri=http://linked.data.gov.au/def/borehole-design$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/borehole-design" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=borehole-design&uri=http://linked.data.gov.au/def/borehole-design&_mediatype=text/turtle" ;
            schema:name "borehole-design RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/borehole-design" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=borehole-design&uri=http://linked.data.gov.au/def/borehole-design" ;
            schema:name "borehole-design HTML" ;
        ] ;
