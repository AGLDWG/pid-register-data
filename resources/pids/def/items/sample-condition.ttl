PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/sample-condition>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/sample-condition($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-condition$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/sample-condition.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-condition$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/sample-condition($|/.*) "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-condition$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/sample-condition" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-condition" ;
            schema:name "sample-condition HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/sample-condition" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-condition&_mediatype=text/turtle" ;
            schema:name "sample-condition RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/sample-condition/fair" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-condition/fair" ;
            schema:name "sample-condition Concept HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/chee.ng> ;
    schema:dateCreated "2024-12-10"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Sample/Specimen condition" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/sample-condition"^^pid:agldwgPid ;
.
