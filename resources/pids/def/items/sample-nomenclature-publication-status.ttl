PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/sample-nomenclature-publication-status>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/sample-nomenclature-publication-status($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-nomenclature-publication-status$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/sample-nomenclature-publication-status.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-nomenclature-publication-status$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/sample-nomenclature-publication-status($|/.*) "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-nomenclature-publication-status$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/sample-nomenclature-publication-status" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-nomenclature-publication-status" ;
            schema:name "sample-nomenclature-publication-status HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/sample-nomenclature-publication-status" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-nomenclature-publication-status&_mediatype=text/turtle" ;
            schema:name "sample-nomenclature-publication-status RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/sample-nomenclature-publication-status/type-specimen-meteorite" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-nomenclature-publication-status/type-specimen-meteorite" ;
            schema:name "sample-nomenclature-publication-status Concept HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/chee.ng> ;
    schema:dateCreated "2024-12-10"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Sample/specimen nomenclature and publication status" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/sample-nomenclature-publication-status"^^pid:agldwgPid ;
.
