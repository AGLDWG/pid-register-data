PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/datatype>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/datatype(.*)$                         https://raw.githack.com/AGLDWG/datatype-ont/master/rdf/datatype.ttl? [R=302,L]
RewriteRule ^/def/datatype(.*).ttl$                     https://raw.githack.com/AGLDWG/datatype-ont/master/rdf/datatype.ttl [R=302,L]
RewriteRule ^/def/datatype(.*)$                         https://raw.githack.com/AGLDWG/datatype-ont/master/html/datatype.html$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/datatype?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/datatype-ont/master/rdf/datatype.ttl" ;
            schema:name "Datatype Ontology, RDF (turtle) via QSA" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/datatype" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/datatype-ont/master/html/datatype.html" ;
            schema:name "Datatype Ontology, HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/datatype.ttl" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/datatype-ont/master/rdf/datatype.ttl" ;
            schema:name "Datatype Ontology, RDF (turtle) via file ext." ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/datatype" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/AGLDWG/datatype-ont/master/rdf/datatype.ttl" ;
            schema:name "Datatype Ontology, RDF (turtle) via conneg" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/simon.cox> ;
    schema:dateCreated "2019-06-11"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Data types" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/datatype"^^pid:agldwgPid ;
.
