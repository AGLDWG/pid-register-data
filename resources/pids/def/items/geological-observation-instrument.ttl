    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geological-observation-instrument($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=geological-observation-instrument&uri=http://linked.data.gov.au/def/geological-observation-instrument$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/geological-observation-instrument($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=geological-observation-instrument&uri=http://linked.data.gov.au/def/geological-observation-instrument$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geological-observation-instrument" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=geological-observation-instrument&uri=http://linked.data.gov.au/def/geological-observation-instrument&_mediatype=text/turtle" ;
            schema:name "geological-observation-instrument RDF" ;
        ] ,
        [
