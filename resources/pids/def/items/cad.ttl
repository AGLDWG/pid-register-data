PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/cad>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} _mediatype=text/turtle
RewriteRule ^/def/cad                   https://raw.githubusercontent.com/Spatial-Information-QLD/cadastre-model/main/model.ttl [R=302,L]
RewriteRule ^/def/cad.ttl               https://raw.githubusercontent.com/Spatial-Information-QLD/cadastre-model/main/model.ttl [R=302,L]
RewriteRule ^/def/cad                   https://spatial-information-qld.github.io/cadastre-model/model.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/cad?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githubusercontent.com/Spatial-Information-QLD/cadastre-model/main/model.ttl?_mediatype=text/turtle" ;
            schema:name "cad RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/cad" ;
            pid:headers "" ;
            pid:to "https://spatial-information-qld.github.io/cadastre-model/model.html" ;
            schema:name "cad HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/garry.thomson> ;
    schema:dateCreated "2023-04-26"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Cadastre Model" ;
    schema:sponsor <https://linked.data.gov.au/org/qsi> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/cad"^^pid:agldwgPid ;
.
