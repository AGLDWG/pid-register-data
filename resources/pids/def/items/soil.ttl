PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/soil>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^\\/def\\/soil($|\\#.+$)                       https://raw.githubusercontent.com/ANZSoilData/def-au-domain/main/rdf/domain.ttl$1 [R=302,L]
RewriteRule ^/def/soil.ttl$                             https://raw.githubusercontent.com/ANZSoilData/def-au-domain/main/rdf/domain.ttl [R=302,L]
RewriteRule ^\\/def\\/soil($|\\#.+$)                       https://raw.githack.com/ANZSoilData/def-au-domain/main/doc/domain.html$1 [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/soil" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githubusercontent.com/ANZSoilData/def-au-domain/main/rdf/domain.ttl" ;
            schema:name "Soil Ontology - RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/soil" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/ANZSoilData/def-au-domain/main/doc/domain.html" ;
            schema:name "Soil Ontology - HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/mr.wong> ;
    schema:dateCreated "2024-03-19"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Ontology for the Australian National Soil Information System (ANSIS)" ;
    schema:sponsor <https://linked.data.gov.au/org/csiro> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    schema:url "https://linked.data.gov.au/def/soil"^^pid:agldwgPid ;
.
