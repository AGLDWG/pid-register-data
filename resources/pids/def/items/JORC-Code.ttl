PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/JORC-Code>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/JORC-Code($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/JORC-Code$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/JORC-Code.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/JORC-Code$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/JORC-Code($|/.*) "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/JORC-Code$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/JORC-Code" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/JORC-Code&_mediatype=text/turtle" ;
            schema:name "JORC-Code RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/JORC-Code" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/JORC-Code" ;
            schema:name "JORC Code vocab HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/chee.ng> ;
    schema:dateCreated "2023-11-02"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "JORC Code" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
