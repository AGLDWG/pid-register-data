PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/earth-science-data-category>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/earth-science-data-category($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/earth-science-data-category$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/earth-science-data-category($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/earth-science-data-category$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/earth-science-data-category" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/earth-science-data-category&_mediatype=text/turtle" ;
            schema:name "earth-science-data-category RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/earth-science-data-category" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/earth-science-data-category" ;
            schema:name "earth-science-data-category HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/david.crosswell> ;
    schema:dateCreated "2019-06-04"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Earth Science Data Category" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/earth-science-data-category"^^pid:agldwgPid ;
.
