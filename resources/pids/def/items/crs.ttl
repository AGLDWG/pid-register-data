PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/crs>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/crs(.*)$                              https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/schema/crs.ttl? [R=302,L]
RewriteRule ^/def/crs(.*).ttl$                          https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/schema/crs.ttl [R=302,L]
RewriteRule ^/def/crs(.*)$                              https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/html/crs.html$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/crs.ttl" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/schema/crs.ttl" ;
            schema:name "ASGS Ontology, RDF (turtle) via file ext." ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/crs" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/schema/crs.ttl" ;
            schema:name "ASGS Ontology, RDF (turtle) via conneg" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/crs" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/html/crs.html" ;
            schema:name "ASGS Ontology, HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/crs?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/CSIRO-enviro-informatics/crs-ont/master/schema/crs.ttl" ;
            schema:name "ASGS Ontology, RDF (turtle) via QSA" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/tatiana.antsoupova> ;
    schema:dateCreated "2019-08-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "CRS Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/neii> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/crs"^^pid:agldwgPid ;
.
