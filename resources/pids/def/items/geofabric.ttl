PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/geofabric>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geofabric$                             https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.ttl? [R=302,L]
RewriteRule ^/def/geofabric.ttl$                        https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.ttl? [R=302,L]
RewriteRule ^/def/geofabric$                            https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.html$1? [R=302,L]
RewriteRule ^/def/geofabric/(.*)                        https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.html\\#$1 [R=302,L,NE]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geofabric.ttl" ;
            pid:headers "" ;
            pid:to "https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.ttl" ;
            schema:name "Geofabric Ontology, RDF (turtle) via file ext." ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geofabric?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.ttl" ;
            schema:name "Geofabric Ontology, RDF (turtle) via QSA" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geofabric" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.ttl" ;
            schema:name "Geofabric Ontology, RDF (turtle) via conneg" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geofabric" ;
            pid:headers "" ;
            pid:to "https://csiro-enviro-informatics.github.io/geofabric-ont/geofabric.html" ;
            schema:name "Geofabric Ontology, HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/simon.cox> ;
    schema:dateCreated "2019-08-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Geofabric Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/csiro> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/geofabric"^^pid:agldwgPid ;
.
