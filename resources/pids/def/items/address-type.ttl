PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/address-type>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/address-type($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=address-type&uri=http://linked.data.gov.au/def/address-type$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/address-type($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=address-type&uri=http://linked.data.gov.au/def/address-type$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/address-type" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=address-type&uri=http://linked.data.gov.au/def/address-type&_mediatype=text/turtle" ;
            schema:name "address-type RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/address-type" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=address-type&uri=http://linked.data.gov.au/def/address-type" ;
            schema:name "address-type HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/anne.goldsack> ;
    schema:dateCreated "2022-06-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/address-type"^^pid:agldwgPid ;
.
