PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/australian-physiographic-units>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/australian-physiographic-units($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/australian-physiographic-units$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/australian-physiographic-units.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/australian-physiographic-units$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/australian-physiographic-units($|/.*) "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/australian-physiographic-units$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/australian-physiographic-units" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/australian-physiographic-units&_mediatype=text/turtle" ;
            schema:name "australian-physiographic-units RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/australian-physiographic-units" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/australian-physiographic-units" ;
            schema:name "australian-physiographic-units HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/chee.ng> ;
    schema:dateCreated "2023-09-27"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Australian physiographic units" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/australian-physiographic-units"^^pid:agldwgPid ;
