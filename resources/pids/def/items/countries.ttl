PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/countries>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/countries($|/.*)$ "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/countries$1&_profile=prez:OGCItemProfile&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/countries(.*).ttl$ "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/countries$1&_profile=prez:OGCItemProfile&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/countries($|/.*)$ "https://icsm.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/countries$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/countries" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/countries&_profile=prez:OGCItemProfile&_mediatype=text/turtle" ;
            schema:name "countries RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/countries" ;
            pid:headers "" ;
            pid:to "https://icsm.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/countries" ;
            schema:name "countries HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/steven.bowden> ;
    schema:dateCreated "2023-04-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Countries" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/countries"^^pid:agldwgPid ;
.
