PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/geosample>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geosample$                   https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/geosample.ttl [R=302,L]
RewriteRule ^/def/geosample.ttl$               https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/geosample.ttl [R=302,L]
RewriteRule ^/def/geosample$                   https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/geosample/ [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geosample" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/geosample.ttl" ;
            schema:name "geosample HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geosample" ;
            pid:headers "" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/geosample/" ;
            schema:name "geosample RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "Geosample" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:url "https://linked.data.gov.au/def/geosample"^^pid:agldwgPid ;
.
