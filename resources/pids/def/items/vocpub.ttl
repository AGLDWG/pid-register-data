PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/vocpub>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/vocpub$                            https://agldwg.github.io/vocpub-profile/profile.ttl? [R=302,L]
RewriteRule ^/def/vocpub.ttl$                        https://agldwg.github.io/vocpub-profile/profile.ttl? [R=302,L]
RewriteRule ^/def/vocpub$                            https://agldwg.github.io/vocpub-profile/profile.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/vocpub" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://agldwg.github.io/vocpub-profile/profile.ttl" ;
            schema:name "AGLDWG Vocab Derivation Modes vocabulary RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/vocpub" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/vocpub-profile/profile.html" ;
            schema:name "AGLDWG Vocab Derivation Modes Vocabulary HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2023-10-04"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "VocPub Profile" ;
    schema:url "https://linked.data.gov.au/def/vocpub"^^pid:agldwgPid ;
.
