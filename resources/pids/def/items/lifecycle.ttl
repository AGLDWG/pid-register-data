PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/lifecycle>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/lifecycle$         https://agldwg.github.io/lifecycle-model/model.ttl [R=302,L]
RewriteRule ^/def/lifecycle$         https://agldwg.github.io/lifecycle-model/model.html [R=302,L]
RewriteRule ^/def/lifecycle.ttl$     https://agldwg.github.io/lifecycle-model/model.ttl [R=302,L]
RewriteRule ^/def/lifecycle($|/.*)$  https://agldwg.github.io/lifecycle-model/model.ttl [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/lifecycle/LifecycleStage" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/lifecycle-model/model.ttl" ;
            schema:name "Lifecycle Model LifecycleStage Class" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/lifecycle" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/lifecycle-model/model.html" ;
            schema:name "Lifecycle Model Specification HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/lifecycle" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://agldwg.github.io/lifecycle-model/model.ttl" ;
            schema:name "Lifecycle Model Specification RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/lifecycle/" ;
            pid:headers "" ;
            pid:to "https://agldwg.github.io/lifecycle-model/model.ttl" ;
            schema:name "Lifecycle Model Namespace RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2023-05-26"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Cadastre Model" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/lifecycle"^^pid:agldwgPid ;
.
