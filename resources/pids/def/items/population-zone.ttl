PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/population-zone>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/population-zone($|/.*)$ "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/population-zone$1&_profile=prez:OGCItemProfile&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/population-zone(.*).ttl$ "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/population-zone$1&_profile=prez:OGCItemProfile&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/population-zone($|/.*)$ "https://icsm.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/population-zone$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/population-zone" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/population-zone&_profile=prez:OGCItemProfile&_mediatype=text/turtle" ;
            schema:name "population-zone RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/population-zone" ;
            pid:headers "" ;
            pid:to "https://icsm.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/population-zone" ;
            schema:name "population-zone HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2023-06-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/icsm> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/population-zone"^^pid:agldwgPid ;
.
