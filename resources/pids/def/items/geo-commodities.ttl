PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/geo-commodities>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geo-commodities($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=geo-commodities&uri=http://linked.data.gov.au/def/geo-commodities$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/geo-commodities($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=geo-commodities&uri=http://linked.data.gov.au/def/geo-commodities$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geo-commodities" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=geo-commodities&uri=http://linked.data.gov.au/def/geo-commodities&_mediatype=text/turtle" ;
            schema:name "geo-commodities RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geo-commodities" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=geo-commodities&uri=http://linked.data.gov.au/def/geo-commodities" ;
            schema:name "geo-commodities HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/david.crosswell> ;
    schema:dateCreated "2020-10-09"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Geo-Commodities" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/geo-commodities"^^pid:agldwgPid ;
.
