PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/gswa-supermodel>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/gswa-supermodel$ https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/profile.ttl [R=302,L]
RewriteRule ^/def/gswa-supermodel.ttl$ https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/profile.ttl [R=302,L]
RewriteRule ^/def/gswa-supermodel$ https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/ [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gswa-supermodel" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/profile.ttl" ;
            schema:name "gswa-supermodel RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gswa-supermodel" ;
            pid:headers "" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/" ;
            schema:name "gswa-supermodel HTML" ;
        ] ;
