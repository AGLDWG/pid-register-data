PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/qld-data-licenses>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/qld-data-licenses($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=qld-data-licenses&uri=https://linked.data.gov.au/def/qld-data-licenses$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qld-data-licenses(.*).ttl$ "https://vocabs.gsq.digital/object?vocab_id=qld-data-licenses&uri=https://linked.data.gov.au/def/qld-data-licenses$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qld-data-licenses($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=qld-data-licenses&uri=https://linked.data.gov.au/def/qld-data-licenses$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qld-data-licenses" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=qld-data-licenses&uri=https://linked.data.gov.au/def/qld-data-licenses&_mediatype=text/turtle" ;
            schema:name "qld-data-licenses RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qld-data-licenses" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=qld-data-licenses&uri=https://linked.data.gov.au/def/qld-data-licenses" ;
            schema:name "qld-data-licenses HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/daniel.brough> ;
    schema:dateCreated "2020-12-08"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Qld Data Licenses" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/qld-data-licenses"^^pid:agldwgPid ;
.
