PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/alum>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^/def/alum($|/.*)$ "https://vocabs.ardc.edu.au/repository/api/lda/abares/australian-land-use-and-management-classification/version-8-with-pids/resource.ttl?uri=https://linked.data.gov.au/def/alum$1" [R=302,L]
RewriteRule ^/def/alum($|/.*)$ "https://vocabs.ardc.edu.au/repository/api/lda/abares/australian-land-use-and-management-classification/version-8-with-pids/resource?uri=https://linked.data.gov.au/def/alum$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/alum" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.ardc.edu.au/repository/api/lda/abares/australian-land-use-and-management-classification/version-8-with-pids/resource.ttl?uri=https://linked.data.gov.au/def/alum" ;
            schema:name "alum RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/alum" ;
            pid:headers "" ;
            pid:to "https://vocabs.ardc.edu.au/repository/api/lda/abares/australian-land-use-and-management-classification/version-8-with-pids/resource?uri=https://linked.data.gov.au/def/alum" ;
            schema:name "alum HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/simon.cox> ;
