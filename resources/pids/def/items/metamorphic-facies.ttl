PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/metamorphic-facies>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/metamorphic-facies($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-facies$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/metamorphic-facies.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-facies$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/metamorphic-facies($|/.*) "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-facies$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/metamorphic-facies" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-facies&_mediatype=text/turtle" ;
            schema:name "metamorphic-facies RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/metamorphic-facies" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-facies" ;
            schema:name "Metamorphic Facies HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/chee.ng> ;
    schema:dateCreated "2023-11-02"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Metamorphic facies" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/metamorphic-facies"^^pid:agldwgPid ;
.
