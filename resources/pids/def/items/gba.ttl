            pid:headers "" ;
            pid:to "http://registry.it.csiro.au/def/gba?_mediatype=ttl" ;
            schema:name "GeoBioregional Assessments Definitions JSON-LD, QSA" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gba" ;
