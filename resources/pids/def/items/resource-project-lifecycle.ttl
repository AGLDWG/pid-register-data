PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/resource-project-lifecycle>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/resource-project-lifecycle($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=resource-project-lifecycle&uri=http://linked.data.gov.au/def/resource-project-lifecycle$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/resource-project-lifecycle($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=resource-project-lifecycle&uri=http://linked.data.gov.au/def/resource-project-lifecycle$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-project-lifecycle" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=resource-project-lifecycle&uri=http://linked.data.gov.au/def/resource-project-lifecycle&_mediatype=text/turtle" ;
            schema:name "resource-project-lifecycle RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-project-lifecycle" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=resource-project-lifecycle&uri=http://linked.data.gov.au/def/resource-project-lifecycle" ;
            schema:name "resource-project-lifecycle HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/david.crosswell> ;
    schema:dateCreated "2023-03-16"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/resource-project-lifecycle"^^pid:agldwgPid ;
.
