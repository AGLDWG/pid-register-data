PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/resource-occurrence>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/resource-occurrence$         https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/resource-occurrence.ttl [R=302,L]
RewriteRule ^/def/resource-occurrence.ttl$     https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/resource-occurrence.ttl [R=302,L]
RewriteRule ^/def/resource-occurrence$         https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/resource-occurrence/ [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-occurrence" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/resource-occurrence.ttl" ;
            schema:name "resource-occurrence HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-occurrence" ;
            pid:headers "" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/resource-occurrence/" ;
            schema:name "resource-occurrence RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "Resource Occurrence" ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:url "https://linked.data.gov.au/def/resource-occurrence"^^pid:agldwgPid ;
.
