PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/resource-types>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/resource-types($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/resource-types$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/resource-types(.*).ttl$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/resource-types$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/resource-types($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/resource-types$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-types" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/resource-types&_mediatype=text/turtle" ;
            schema:name "resource-types RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-types" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/resource-types" ;
            schema:name "resource-types HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/daniel.brough> ;
    schema:dateCreated "2020-12-08"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "DataCite Resource Types" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/resource-types"^^pid:agldwgPid ;
.
