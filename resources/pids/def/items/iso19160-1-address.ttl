            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/iso19160-1-address-ont/master/iso19160-1.html" ;
            schema:name "ISO19160 Ontology element, HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/iso19160-1-address" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/AGLDWG/iso19160-1-address-ont/master/iso19160-1.ttl" ;
            schema:name "ISO19160 Ontology, RDF (turtle) via conneg" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/iso19160-1-address?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/iso19160-1-address-ont/master/iso19160-1.ttl" ;
            schema:name "ISO19160 Ontology, RDF (turtle) via QSA" ;
        ] ,
        [
            a pid:RedirectTest ;
