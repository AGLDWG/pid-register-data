PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/qesd-uom>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/qesd-uom($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qesd-uom$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qesd-uom($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qesd-uom$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qesd-uom" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qesd-uom&_mediatype=text/turtle" ;
            schema:name "qesd-uom RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qesd-uom" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qesd-uom" ;
            schema:name "qesd-uom HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/daniel.brough> ;
    schema:dateCreated "2021-04-28"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Queensland Environmental Science Data Profile of QUDT Units" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/qesd-uom"^^pid:agldwgPid ;
.
