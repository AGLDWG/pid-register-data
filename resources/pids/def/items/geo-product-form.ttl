PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/geo-product-form>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/geo-product-form($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/geo-product-form$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/geo-product-form(.*).ttl$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/geo-product-form$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/geo-product-form($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/geo-product-form$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geo-product-form" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/geo-product-form&_mediatype=text/turtle" ;
            schema:name "geo-product-form RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/geo-product-form" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/geo-product-form" ;
            schema:name "geo-product-form HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/steven.bowden> ;
    schema:dateCreated "2023-04-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Geoscience Commodity Product Forms" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/geo-product-form"^^pid:agldwgPid ;
.
