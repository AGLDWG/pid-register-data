PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/dataset>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/dataset($|/.*)                        https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.ttl? [R=302,L]
RewriteRule ^/def/dataset(|/.*).ttl$                    https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.ttl [R=302,L]
RewriteRule ^/def/dataset($|(/.*))                      https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.html$2 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/dataset" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.ttl" ;
            schema:name "Dataset Ontology, RDF (turtle) via conneg" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/dataset.ttl" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.ttl" ;
            schema:name "Dataset Ontology, RDF (turtle) via file ext." ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/dataset" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.html" ;
            schema:name "Datatype Ontology, HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/dataset?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/dataset-ont/master/dataset.ttl" ;
            schema:name "Dataset Ontology, RDF (turtle) via QSA" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/armin.haller> ;
    schema:dateCreated "2019-04-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Dataset Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/dataset"^^pid:agldwgPid ;
.
