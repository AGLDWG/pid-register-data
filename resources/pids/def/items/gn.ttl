PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/gn>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} _mediatype=text/turtle
RewriteRule ^/def/gn($|/.*)             https://raw.githubusercontent.com/Spatial-Information-QLD/geographical-names-model/main/model.ttl [R=302,L]
RewriteRule ^/def/gn.ttl                https://raw.githubusercontent.com/Spatial-Information-QLD/geographical-names-model/main/model.ttl [R=302,L]
RewriteRule ^/def/gn($|/.*)             https://spatial-information-qld.github.io/geographical-names-model/model.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gn" ;
            pid:headers "" ;
            pid:to "https://spatial-information-qld.github.io/geographical-names-model/model.html" ;
            schema:name "gn HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/gn?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githubusercontent.com/Spatial-Information-QLD/geographical-names-model/main/model.ttl?_mediatype=text/turtle" ;
            schema:name "gn RDF (Turtle)" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2024-04-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Geographical Names Model" ;
    schema:sponsor <https://linked.data.gov.au/org/icsm> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/gn"^^pid:agldwgPid ;
.
