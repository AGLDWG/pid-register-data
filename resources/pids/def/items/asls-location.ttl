PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/asls-location>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/asls-location($|/.+)$                 https://vocabs.ardc.edu.au/repository/api/lda/csiro/asls-location-classifiers/3ed/resource.ttl?uri=http://anzsoil.org/def/au/asls/location$1 [R=302,L]
RewriteRule ^/def/asls-location.ttl$                    https://vocabs.ardc.edu.au/repository/api/lda/csiro/asls-location-classifiers/3ed/resource.ttl?uri=http://anzsoil.org/def/au/asls/location [R=302,L]
RewriteRule ^/def/asls-location($|/.+)$                 https://vocabs.ardc.edu.au/repository/api/lda/csiro/asls-location-classifiers/3ed/resource?uri=http://anzsoil.org/def/au/asls/location$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/asls-location" ;
            pid:headers "" ;
            pid:to "https://vocabs.ardc.edu.au/repository/api/lda/csiro/asls-location-classifiers/3ed/resource?uri=http://anzsoil.org/def/au/asls/location" ;
            schema:name "ASLS Location classifiers - HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/asls-location/accuracy-4" ;
            pid:headers "" ;
            pid:to "https://vocabs.ardc.edu.au/repository/api/lda/csiro/asls-location-classifiers/3ed/resource?uri=http://anzsoil.org/def/au/asls/location/accuracy-4" ;
            schema:name "ASLS Location classifiers - one Concept HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/asls-location" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.ardc.edu.au/repository/api/lda/csiro/asls-location-classifiers/3ed/resource.ttl?uri=http://anzsoil.org/def/au/asls/location" ;
            schema:name "ASLS Location classifiers - RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/mr.wong> ;
    schema:dateCreated "2024-03-19"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "ASLS Location classifiers" ;
    schema:sponsor <https://linked.data.gov.au/org/csiro> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    schema:url "https://linked.data.gov.au/def/asls-location"^^pid:agldwgPid ;
.
