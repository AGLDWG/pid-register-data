PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/nsw-quality-dimension>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/nsw-quality-dimension($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/nsw-quality-dimension$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/nsw-quality-dimension(.*).ttl$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/nsw-quality-dimension$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/nsw-quality-dimension($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/nsw-quality-dimension$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/nsw-quality-dimension" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/nsw-quality-dimension&_mediatype=text/turtle" ;
            schema:name "nsw-quality-dimension RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/nsw-quality-dimension" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/nsw-quality-dimension" ;
            schema:name "nsw-quality-dimension HTML" ;
        ] ;
