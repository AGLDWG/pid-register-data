            pid:to "https://icsm-au.github.io/addr-creation-maintenance/doc.html" ;
            schema:name "Address Creation & Maintenance Specification HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/anne.goldsack> ;
