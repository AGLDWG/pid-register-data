PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/nslvoc>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/nslvoc($|/.*)$                        https://biodiversity.org.au/voc/aunsl.ttl [R=302,L]
RewriteRule ^/def/nslvoc.ttl$                           https://biodiversity.org.au/voc/aunsl.ttl [R=302,L]
RewriteRule ^/def/nslvoc($|/.*)$                        https://biodiversity.org.au/voc/aunsl.html [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/nslvoc" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://biodiversity.org.au/voc/aunsl.ttl" ;
            schema:name "nslvoc RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/nslvoc" ;
            pid:headers "" ;
            pid:to "https://biodiversity.org.au/voc/aunsl.html" ;
            schema:name "nslvoc HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/endymion.cooper> ;
    schema:dateCreated "2023"^^xsd:gYear ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Australian National Species List Vocabulary" ;
    schema:sponsor <https://linked.data.gov.au/org/finance> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    schema:url "https://linked.data.gov.au/def/nslvoc"^^pid:agldwgPid ;
.
