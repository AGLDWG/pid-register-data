PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/nsl>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/nsl$                                  https://kurrawong.github.io/nsl-model/profile.ttl [R=302,L]
RewriteRule ^/def/nsl.ttl$                              https://kurrawong.github.io/nsl-model/profile.ttl [R=302,L]
RewriteRule ^/def/nsl$                                  https://kurrawong.github.io/nsl-model/spec.html [R=302,NE,L]

RewriteRule ^/def/nsl/validator$                        https://kurrawong.github.io/nsl-model/validator.ttl [R=302,L]
RewriteRule ^/def/nsl/context.json$                     https://kurrawong.github.io/nsl-model/context.json [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/nsl" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://kurrawong.github.io/nsl-model/profile.ttl" ;
            schema:name "nsl RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/nsl" ;
            pid:headers "" ;
            pid:to "https://kurrawong.github.io/nsl-model/spec.html" ;
            schema:name "nsl HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/endymion.cooper> ;
    schema:dateCreated "2024-01-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "National Species List Data Model" ;
    schema:sponsor <https://linked.data.gov.au/org/dcceew> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    schema:url "https://linked.data.gov.au/def/nsl"^^pid:agldwgPid ;
.
