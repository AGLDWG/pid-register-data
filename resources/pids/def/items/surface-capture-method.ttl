PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/surface-capture-method>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/surface-capture-method($|/.*)$ "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/surface-capture-method$1&_profile=prez:OGCItemProfile&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/surface-capture-method(.*).ttl$ "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/surface-capture-method$1&_profile=prez:OGCItemProfile&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/surface-capture-method($|/.*)$ "https://icsm.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/surface-capture-method$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/surface-capture-method" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://icsm-api.qlocation.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/surface-capture-method&_profile=prez:OGCItemProfile&_mediatype=text/turtle" ;
            schema:name "surface-capture-method RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/surface-capture-method" ;
            pid:headers "" ;
            pid:to "https://icsm.information.qld.gov.au/object?uri=https://linked.data.gov.au/def/surface-capture-method" ;
            schema:name "surface-capture-method HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/david.crosswell> ;
    schema:dateCreated "2020-03-30"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/idn> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
