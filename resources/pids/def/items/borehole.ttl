RewriteRule ^/def/borehole$                         https://raw.githack.com/geological-survey-of-queensland/gsq-borehole-profile/master/borehole.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
