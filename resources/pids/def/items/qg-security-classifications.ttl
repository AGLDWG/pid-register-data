PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/qg-security-classifications>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/qg-security-classifications($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=qg-security-classifications&uri=https://linked.data.gov.au/def/qg-security-classifications$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qg-security-classifications(.*).ttl$ "https://vocabs.gsq.digital/object?vocab_id=qg-security-classifications&uri=https://linked.data.gov.au/def/qg-security-classifications$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qg-security-classifications($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=qg-security-classifications&uri=https://linked.data.gov.au/def/qg-security-classifications$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qg-security-classifications" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=qg-security-classifications&uri=https://linked.data.gov.au/def/qg-security-classifications&_mediatype=text/turtle" ;
            schema:name "qg-security-classifications RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qg-security-classifications" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=qg-security-classifications&uri=https://linked.data.gov.au/def/qg-security-classifications" ;
            schema:name "qg-security-classifications HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/daniel.brough> ;
    schema:dateCreated "2020-12-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Queensland Government Information Security Classifications" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/qg-security-classifications"^^pid:agldwgPid ;
.
