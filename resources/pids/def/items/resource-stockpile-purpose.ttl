PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/resource-stockpile-purpose>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/resource-stockpile-purpose($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/resource-stockpile-purpose$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/resource-stockpile-purpose(.*).ttl$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/resource-stockpile-purpose$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/resource-stockpile-purpose($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/resource-stockpile-purpose$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-stockpile-purpose" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/resource-stockpile-purpose&_mediatype=text/turtle" ;
            schema:name "resource-stockpile-purpose RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/resource-stockpile-purpose" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/resource-stockpile-purpose" ;
            schema:name "resource-stockpile-purpose HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/steven.bowden> ;
    schema:dateCreated "2023-04-06"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Resource stockpile purpose" ;
