PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/agrif>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/agrif(.*)$                            https://raw.githack.com/agldwg/agrif-ont/master/agrif.ttl? [R=302,L]
RewriteRule ^/def/agrif(.*).ttl$                        https://raw.githack.com/agldwg/agrif-ont/master/agrif.ttl [R=302,L]
RewriteRule ^/def/agrif(.*)$                            https://raw.githack.com/agldwg/agrif-ont/master/agrif.html$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/agrif?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/agldwg/agrif-ont/master/agrif.ttl" ;
            schema:name "AGRIF Ontology, RDF (turtle) via QSA" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/agrif.ttl" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/agldwg/agrif-ont/master/agrif.ttl" ;
            schema:name "AGRIF Ontology, RDF (turtle) via file ext." ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/agrif" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/agldwg/agrif-ont/master/agrif.ttl" ;
            schema:name "AGRIF Ontology, HTRDF (turtle) via conneg" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/agrif" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/agldwg/agrif-ont/master/agrif.html" ;
            schema:name "AGRIF Ontology, HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/john.machin> ;
    schema:dateCreated "2019-08-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "AGRIF Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/ga> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/agrif"^^pid:agldwgPid ;
.
