PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/qld-export-terminals>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/qld-export-terminals($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/qld-export-terminals$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qld-export-terminals(.*).ttl$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/qld-export-terminals$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qld-export-terminals($|/.*)$ "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/qld-export-terminals$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qld-export-terminals" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/qld-export-terminals&_mediatype=text/turtle" ;
            schema:name "qld-export-terminals RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qld-export-terminals" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=http://linked.data.gov.au/def/qld-export-terminals" ;
            schema:name "qld-export-terminals HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/Steven.Bowden> ;
    schema:dateCreated "2023-04-13"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Qld export terminals" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/qld-export-terminals"^^pid:agldwgPid ;
.
