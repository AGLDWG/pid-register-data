    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/sample-data-quality-management($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-data-quality-management$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/sample-data-quality-management.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/sample-data-quality-management$1&_mediatype=text/turtle" [R=302,L]
