PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/valpub>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^/def/valpub$                        https://agldwg.github.io/valpub-profile/profile.ttl [R=302,L]
RewriteRule ^/def/valpub.ttl$                    https://agldwg.github.io/valpub-profile/profile.ttl [R=302,L]
RewriteRule ^/def/valpub/validator               https://agldwg.github.io/valpub-profile/validators/validator.ttl [R=302,L]
RewriteRule ^/def/valpub/repo                    https://github.com/AGLDWG/valpub-profile [R=302,L]
RewriteRule ^/def/valpub/spec                    https://agldwg.github.io/valpub-profile/specification.html [R=302,L]
RewriteRule ^/def/valpub                         https://agldwg.github.io/valpub-profile/profile.html [R=302,L]"""^^pid:apacheRedirectRules ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "ValPub Profile" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:url "https://linked.data.gov.au/def/valpub"^^pid:agldwgPid ;
.
