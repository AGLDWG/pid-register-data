<https://linked.data.gov.au/pid/def/metamorphic-P-T-trajectory>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/metamorphic-P-T-trajectory($|/.*)$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-P-T-trajectory$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/metamorphic-P-T-trajectory.ttl$ "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-P-T-trajectory$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/metamorphic-P-T-trajectory($|/.*) "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-P-T-trajectory$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/metamorphic-P-T-trajectory" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-P-T-trajectory&_mediatype=text/turtle" ;
            schema:name "metamorphic-P-T-trajectory RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/metamorphic-P-T-trajectory" ;
            pid:headers "" ;
            pid:to "https://vocabulary.gswa.kurrawong.ai/object?uri=https://linked.data.gov.au/def/metamorphic-P-T-trajectory" ;
            schema:name "Metamorphic P-T Trajectory vocab HTML" ;
        ] ;
