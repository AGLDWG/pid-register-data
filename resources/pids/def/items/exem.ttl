PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/exem>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/exem                https://kurrawong.github.io/exem-ont/exem.ttl [R=302,L]
RewriteRule ^/def/exem.ttl$           https://kurrawong.github.io/exem-ont/exem.ttl [R=302,L]
RewriteRule ^/def/exem$               https://kurrawong.github.io/exem-ont/exem.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/exem" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://kurrawong.github.io/exem-ont/exem.ttl" ;
            schema:name "exem RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/exem" ;
            pid:headers "" ;
            pid:to "https://kurrawong.github.io/exem-ont/exem.html" ;
            schema:name "exem HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2023-06-22"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/icsm> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/exem"^^pid:agldwgPid ;
.
