PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/smurf>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/smurf                                 https://rmit-gkl.github.io/SMURF/smurf.ttl [R=303,L]
RewriteRule ^/def/smurf.ttl                             https://rmit-gkl.github.io/SMURF/smurf.ttl [R=303,L]
RewriteRule ^/def/smurf                                 https://rmit-gkl.github.io/SMURF/smurf.html [R=303,L]"""^^pid:apacheRedirectRules ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "SMURF" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:url "https://linked.data.gov.au/def/smurf"^^pid:agldwgPid ;
.
