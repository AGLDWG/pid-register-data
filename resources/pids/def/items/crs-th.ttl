PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/crs-th>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/crs-th(.*)$                           https://raw.githubusercontent.com/CSIRO-enviro-informatics/crs-th/master/crs-th.ttl? [R=302,L]
RewriteRule ^/def/crs-th(.*).ttl$                       https://raw.githubusercontent.com/CSIRO-enviro-informatics/crs-th/master/crs-th.ttl [R=302,L]
RewriteRule ^/def/crs-th(.*)$                           https://github.com/CSIRO-enviro-informatics/crs-th [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/crs-th" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githubusercontent.com/CSIRO-enviro-informatics/crs-th/master/crs-th.ttl" ;
            schema:name "Vocab RDF (turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/crs-th" ;
            pid:headers "" ;
            pid:to "https://github.com/CSIRO-enviro-informatics/crs-th" ;
            schema:name "Vocab HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/tatiana.antsoupova> ;
    schema:dateCreated "2019-07-18"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "CRS Thesaurus" ;
    schema:sponsor <https://linked.data.gov.au/org/naa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/crs-th"^^pid:agldwgPid ;
.
