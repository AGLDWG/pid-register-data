PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/mining-authorisation>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/mining-authorisation$         https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/mining-authorisation.ttl [R=302,L]
RewriteRule ^/def/mining-authorisation.ttl$     https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/mining-authorisation.ttl [R=302,L]
RewriteRule ^/def/mining-authorisation$         https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/mining-authorisation/ [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/mining-authorisation" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/rdf/components/mining-authorisation.ttl" ;
            schema:name "mining-authorisation HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/mining-authorisation" ;
            pid:headers "" ;
            pid:to "https://geological-survey-of-western-australia.github.io/GSWA-Supermodel/components/mining-authorisation/" ;
            schema:name "mining-authorisation RDF" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2023-12-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/gswa> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/mining-authorisation"^^pid:agldwgPid ;
.
