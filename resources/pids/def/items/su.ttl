PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/su>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/su$                                     https://raw.githack.com/surroundaustralia/su-ont/master/su.ttl [R=303,L]
RewriteRule ^/def/su.ttl$                                 https://raw.githack.com/surroundaustralia/su-ont/master/su.ttl [R=303,L]
RewriteRule ^/def/su$                                     https://raw.githack.com/surroundaustralia/su-ont/master/su.html [R=303,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/su" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/surroundaustralia/su-ont/master/su.ttl" ;
            schema:name "su RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/su" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/surroundaustralia/su-ont/master/su.html" ;
            schema:name "su HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/irina.bastrakova> ;
    schema:dateCreated "2024-03-29"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Stratigraphic Units Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/accepted> ;
    schema:url "https://linked.data.gov.au/def/su"^^pid:agldwgPid ;
.
