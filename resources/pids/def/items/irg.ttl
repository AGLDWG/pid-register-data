PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/irg>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/irg(.*)$                              https://raw.githack.com/AGLDWG/iri-registry-ont/master/irg.ttl? [R=302,L]
RewriteRule ^/def/irg(.*).ttl$                          https://raw.githack.com/AGLDWG/iri-registry-ont/master/irg.ttl$1 [R=302,L]
RewriteRule ^/def/irg(.*)$                              https://raw.githack.com/AGLDWG/iri-registry-ont/master/irg.html$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/irg" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://raw.githack.com/AGLDWG/iri-registry-ont/master/irg.ttl" ;
            schema:name "irg RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/irg" ;
            pid:headers "" ;
            pid:to "https://raw.githack.com/AGLDWG/iri-registry-ont/master/irg.html" ;
            schema:name "irg HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2021-07-06"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "IRI Registry Ontology" ;
    schema:sponsor <https://linked.data.gov.au/org/agldwg> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/irg"^^pid:agldwgPid ;
.
