PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/qg-agent>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/qg-agent($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=qg-agent&uri=https://linked.data.gov.au/def/qg-agent$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qg-agent(.*).ttl$ "https://vocabs.gsq.digital/object?vocab_id=qg-agent&uri=https://linked.data.gov.au/def/qg-agent$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qg-agent($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=qg-agent&uri=https://linked.data.gov.au/def/qg-agent$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qg-agent" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=qg-agent&uri=https://linked.data.gov.au/def/qg-agent&_mediatype=text/turtle" ;
            schema:name "qg-agent RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qg-agent" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=qg-agent&uri=https://linked.data.gov.au/def/qg-agent" ;
            schema:name "qg-agent HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/ScottLutwycheDES> ;
    schema:dateCreated "2021-01-21"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Queensland Government Agencies" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/qg-agent"^^pid:agldwgPid ;
.
