<https://linked.data.gov.au/pid/def/rock-unit-rank>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/rock-unit-rank($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/rock-unit-rank$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/rock-unit-rank(.*).ttl$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/rock-unit-rank$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/rock-unit-rank($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/rock-unit-rank$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/rock-unit-rank" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/rock-unit-rank&_mediatype=text/turtle" ;
            schema:name "rock-unit-rank RDF" ;
        ] ,
        [
