PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/roads>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} _mediatype=text/turtle
RewriteRule ^/def/roads                 https://raw.githubusercontent.com/Spatial-Information-QLD/roads-model/main/model.ttl [R=302,L]
RewriteRule ^/def/roads.ttl             https://raw.githubusercontent.com/Spatial-Information-QLD/roads-model/main/model.ttl [R=302,L]
RewriteRule ^/def/roads                 https://spatial-information-qld.github.io/roads-model/model.html [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/roads?_mediatype=text/turtle" ;
            pid:headers "" ;
            pid:to "https://raw.githubusercontent.com/Spatial-Information-QLD/roads-model/main/model.ttl?_mediatype=text/turtle" ;
            schema:name "roads RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/roads" ;
            pid:headers "" ;
            pid:to "https://spatial-information-qld.github.io/roads-model/model.html" ;
            schema:name "roads HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/anne.goldsack> ;
    schema:dateCreated "2023-04-26"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "Roads Model" ;
    schema:sponsor <https://linked.data.gov.au/org/qsi> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/roads"^^pid:agldwgPid ;
.
