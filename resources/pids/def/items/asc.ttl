PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/asc>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/asc$                              https://anzsoildata.github.io/def-au-asc/rdf/ASC.ttl [R=302,L]
RewriteRule ^/def/asc.ttl$                              https://anzsoildata.github.io/def-au-asc/rdf/ASC.ttl [R=302,L]
RewriteRule ^/def/asc$                              https://anzsoildata.github.io/def-au-asc/ [R=302,L]

RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/asc/(.+)$                             https://vocabs.ardc.edu.au/repository/api/lda/csiro/australian-soil-classification/3ed/resource.ttl?uri=http://anzsoil.org/def/au/asc/$1 [R=302,L]
RewriteRule ^/def/asc/(.+).ttl$                         https://vocabs.ardc.edu.au/repository/api/lda/csiro/australian-soil-classification/3ed/resource.ttl?uri=http://anzsoil.org/def/au/asc/$1 [R=302,L]
RewriteRule ^/def/asc/(.+)$                             https://vocabs.ardc.edu.au/repository/api/lda/csiro/australian-soil-classification/3ed/resource?uri=http://anzsoil.org/def/au/asc/$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/asc/A-horizons" ;
            pid:headers "" ;
            pid:to "https://vocabs.ardc.edu.au/repository/api/lda/csiro/australian-soil-classification/3ed/resource?uri=http://anzsoil.org/def/au/asc/A-horizons" ;
            schema:name "ASLS Australian Soil Classification - one Concept HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/asc" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://anzsoildata.github.io/def-au-asc/rdf/ASC.ttl" ;
            schema:name "ASLS Australian Soil Classification - RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/asc" ;
            pid:headers "" ;
            pid:to "https://anzsoildata.github.io/def-au-asc/" ;
            schema:name "ASLS Australian Soil Classification - HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/mr.wong> ;
    schema:dateCreated "2024-11-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "The Australian Soil Classification" ;
    schema:sponsor <https://linked.data.gov.au/org/csiro> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/asc"^^pid:agldwgPid ;
.
