PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/site-status>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/site-status($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=site-status&uri=http://linked.data.gov.au/def/site-status$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/site-status($|/.*)$ "https://vocabs.gsq.digital/object?vocab_id=site-status&uri=http://linked.data.gov.au/def/site-status$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/site-status" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=site-status&uri=http://linked.data.gov.au/def/site-status&_mediatype=text/turtle" ;
            schema:name "site-status RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/site-status" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?vocab_id=site-status&uri=http://linked.data.gov.au/def/site-status" ;
            schema:name "site-status HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/david.crosswell> ;
    schema:dateCreated "2020-03-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/site-status"^^pid:agldwgPid ;
.
