PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/eia-supermodel>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/eia-supermodel                        https://dcceew-bdr.github.io/eia-supermodel/profile.ttl [R=302,L]
RewriteRule ^/def/eia-supermodel.ttl                    https://dcceew-bdr.github.io/eia-supermodel/profile.ttl [R=302,L]
RewriteRule ^/def/eia-supermodel                        https://dcceew-bdr.github.io/eia-supermodel/ [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/eia-supermodel" ;
            pid:headers "" ;
            pid:to "https://dcceew-bdr.github.io/eia-supermodel/" ;
            schema:name "EIA Supermodel HTML" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/eia-supermodel.ttl" ;
            pid:headers "" ;
            pid:to "https://dcceew-bdr.github.io/eia-supermodel/profile.ttl" ;
            schema:name "EIA Supermodel RDF ending" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/eia-supermodel" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://dcceew-bdr.github.io/eia-supermodel/profile.ttl" ;
            schema:name "EIA Supermodel RDF Accept" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2026-11-25"^^xsd:date ;
    schema:dateModified "2026-11-25"^^xsd:date ;
    schema:name "EIA Supermodel" ;
    schema:sponsor <https://linked.data.gov.au/org/dcceew> ;
    schema:url "https://linked.data.gov.au/def/eia-supermodel"^^pid:agldwgPid ;
.
