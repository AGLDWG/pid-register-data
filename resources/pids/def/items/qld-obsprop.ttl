PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/qld-obsprop>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/qld-obsprop($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qld-obsprop$1&_mediatype=text/turtle" [R=302,L]
RewriteRule ^/def/qld-obsprop($|/.*)$ "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qld-obsprop$1" [R=302,NE,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qld-obsprop" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qld-obsprop&_mediatype=text/turtle" ;
            schema:name "qld-obsprop RDF" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/qld-obsprop" ;
            pid:headers "" ;
            pid:to "https://vocabs.gsq.digital/object?uri=https://linked.data.gov.au/def/qld-obsprop" ;
            schema:name "qld-obsprop HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/daniel.brough> ;
    schema:dateCreated "2021-06-28"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:name "QESD Observed Properties vocabulary" ;
    schema:sponsor <https://linked.data.gov.au/org/gsq> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/qld-obsprop"^^pid:agldwgPid ;
.
