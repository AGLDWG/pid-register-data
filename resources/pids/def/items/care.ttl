PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://linked.data.gov.au/pid/def/care>
    a pid:Pid ;
    pid:redirectRules """RewriteCond %{QUERY_STRING} ^_mediatype=text/turtle$ [OR]
RewriteCond %{HTTP:Accept} text/turtle [NC]
RewriteRule ^/def/care(.*)$                  https://idn-au.github.io/care-voc/care.ttl [R=302,L]
RewriteRule ^/def/care(.*).ttl$              https://idn-au.github.io/care-voc/care.ttl [R=302,L]
RewriteRule ^/def/care(.*)$                  https://idn-au.github.io/care-voc/care.html$1 [R=302,L]"""^^pid:apacheRedirectRules ;
    pid:redirectTest 
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/care" ;
            pid:headers "'Accept': 'text/turtle'" ;
            pid:to "https://idn-au.github.io/care-voc/care.ttl" ;
            schema:name "care RDF (Turtle)" ;
        ] ,
        [
            a pid:RedirectTest ;
            pid:from "https://linked.data.gov.au/def/care" ;
            pid:headers "" ;
            pid:to "https://idn-au.github.io/care-voc/care.html" ;
            schema:name "care HTML" ;
        ] ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2019-12-15"^^xsd:date ;
    schema:dateModified "2026-09-07"^^xsd:date ;
    schema:sponsor <https://linked.data.gov.au/org/idn> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
    schema:url "https://linked.data.gov.au/def/care"^^pid:agldwgPid ;
.
