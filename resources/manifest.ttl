PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX mrr: <https://prez.dev/ManifestResourceRoles/>
PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX prez: <https://prez.dev/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX schema: <https://schema.org/>

[]    a prez:Manifest ;
    prof:hasResource 
        [
            dcterms:conformsTo "validators/items/org.ttl" ;
            prof:hasArtifact "orgs/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType schema:Organization ;
        ] ,
        [
            dcterms:conformsTo "validators/items/pid.ttl" ;
            prof:hasArtifact "pids/env/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType pid:Pid ;
        ] ,
        [
            prof:hasArtifact "validators/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            prof:hasArtifact "pids/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            prof:hasArtifact "pids/org/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo "validators/items/pid.ttl" ;
            prof:hasArtifact "pids/org/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType pid:Pid ;
        ] ,
        [
            prof:hasArtifact "models/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            prof:hasArtifact "validators/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo "validators/items/pid.ttl" ;
            prof:hasArtifact "pids/dataset/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType pid:Pid ;
        ] ,
        [
            prof:hasArtifact "pids/def/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo "validators/items/pid.ttl" ;
            prof:hasArtifact "pids/def/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
            schema:additionalType pid:Pid ;
        ] ,
        [
            prof:hasArtifact "orgs/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            prof:hasArtifact "pids/env/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            prof:hasArtifact "pids/dataset/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            prof:hasArtifact "models/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ;
.
