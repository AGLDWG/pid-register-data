PREFIX : <https://linked.data.gov.au/def/agldwg-org/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sg: <https://linked.data.gov.au/def/agldwg-org>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

sg:
    a owl:Ontology , sh:ShapesGraph ;
    owl:versionIRI :1.0 ;
    skos:historyNote "This validator was first published in the pid-register-data repository on 4 April 2025. Its four original organisation constraints remained substantively unchanged through subsequent file relocations and formatting changes." ;
    schema:codeRepository "https://github.com/AGLDWG/pid-register-data"^^xsd:anyURI ;
    schema:copyrightHolder <https://linked.data.gov.au/org/agldwg> ;
    schema:copyrightNotice "© Commonwealth of Australia (Australian Government Linked Data Working Group), 2026" ;
    schema:copyrightYear "2026"^^xsd:gYear ;
    schema:creator <https://linked.data.gov.au/person/nicholas.car> ;
    schema:dateCreated "2025-04-04"^^xsd:date ;
    schema:dateIssued "2025-04-04"^^xsd:date ;
    schema:dateModified "2026-10-02"^^xsd:date ;
    schema:description "A SHACL validator for organisations recorded in the Australian Government Linked Data Working Group PID Register." ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "AGLDWG Organisations Validator" ;
    schema:publisher <https://linked.data.gov.au/org/agldwg> ;
    schema:version "1.0" ;
.

<https://linked.data.gov.au/org/agldwg>
    a schema:Organization ;
    schema:name "Australian Government Linked Data Working Group" ;
    schema:url "http://www.linked.data.gov.au"^^xsd:anyURI ;
.

<https://linked.data.gov.au/person/nicholas.car>
    a schema:Person ;
    schema:email "nicholas.car@gov.au"^^xsd:anyURI ;
    schema:name "Nicholas Car" ;
.

:org-req-01
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    schema:description "Validates the required and optional properties of organisations in the AGLDWG PID Register." ;
    schema:name "Organisation shape" ;
    sh:property
        :orgDescription ,
        :orgIsPartOf ,
        :orgName ,
        :orgUrl ;
    sh:targetClass schema:Organization ;
.

:agentQualifiedRelation
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    dcterms:source "https://data.idnau.org/pid/agp/spec/0.0.2"^^xsd:anyURI ;
    schema:description "Implements draft Indigenous Data Network Agents Governance Profile requirement AA1 for qualified relationships between agents." ;
    schema:name "Agent qualified relation shape" ;
    sh:sparql
        [
            a sh:SPARQLConstraint ;
            sh:message "Req AA1: A qualified relation between agents must be a dcat:Relationship that identifies another schema:Person or schema:Organization with schema:agent and a skos:Concept role with schema:roleName." ;
            sh:select """
                PREFIX dcat: <http://www.w3.org/ns/dcat#>
                PREFIX schema: <https://schema.org/>
                PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

                SELECT $this ?value
                WHERE {
                    $this dcat:qualifiedRelation ?value .
                    FILTER (
                        NOT EXISTS {
                            ?value a dcat:Relationship .
                        }
                        || NOT EXISTS {
                            ?value schema:agent ?agent .
                            ?agent a ?agentType .
                            FILTER (
                                ?agentType IN (
                                    schema:Organization,
                                    schema:Person
                                )
                            )
                        }
                        || NOT EXISTS {
                            ?value schema:roleName ?role .
                            ?role a skos:Concept .
                        }
                    )
                }
                """ ;
        ] ;
    sh:targetClass schema:Organization ;
.

:orgDescription
    a sh:PropertyShape ;
    rdfs:isDefinedBy sg: ;
    schema:description "Requires an organisation to have exactly one string description." ;
    schema:name "Organisation description property shape" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "An Organisation must have exactly one description" ;
    sh:minCount 1 ;
    sh:path schema:description ;
.

:orgIsPartOf
    a sh:PropertyShape ;
    rdfs:isDefinedBy sg: ;
    schema:description "Permits an organisation to indicate at most one containing organisation by IRI." ;
    schema:name "Organisation is-part-of property shape" ;
    sh:maxCount 1 ;
    sh:message "An Organisation may be indicated as being part of at most one larger organisation by having an isPartOf predicate and if it does, isPartOf must indicate an IRI" ;
    sh:nodeKind sh:IRI ;
    sh:path schema:isPartOf ;
.

:orgName
    a sh:PropertyShape ;
    rdfs:isDefinedBy sg: ;
    schema:description "Requires an organisation to have exactly one string name." ;
    schema:name "Organisation name property shape" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:message "An Organisation must have exactly one name" ;
    sh:minCount 1 ;
    sh:path schema:name ;
.

:orgUrl
    a sh:PropertyShape ;
    rdfs:isDefinedBy sg: ;
    schema:description "Permits an organisation to have at most one URL expressed as an xsd:anyURI literal." ;
    schema:name "Organisation URL property shape" ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
    sh:message "An Organisation may have at most one URL recorded and if it does, it must be of type xsd:anyURI" ;
    sh:path schema:url ;
.
